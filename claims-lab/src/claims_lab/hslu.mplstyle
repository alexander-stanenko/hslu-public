# HSLU brand palette. GENERATED by scripts/hslu_palette.py from tokens.json
# (token_version 2026-09-06). Do not hand-edit; regenerate instead.
#
#   import matplotlib.pyplot as plt
#   plt.style.use('/path/to/hslu-charts/assets/hslu.mplstyle')
#
# Colours carry no leading hash: matplotlib reads it as a comment.

# The stage. White figure, white axes, black ink.
figure.facecolor: FFFFFF
figure.edgecolor: FFFFFF
savefig.facecolor: FFFFFF
savefig.edgecolor: FFFFFF
axes.facecolor: FFFFFF
text.color: 000000
axes.labelcolor: 000000
axes.titlecolor: 000000
xtick.color: 000000
ytick.color: 000000
xtick.labelcolor: 000000
ytick.labelcolor: 000000
hatch.color: 000000

# Type. Verdana is the brand's Office stand-in for FS Albert. The
# fallbacks stop a headless box from silently picking something odd.
font.family: sans-serif
font.sans-serif: Verdana, DejaVu Sans, Tahoma, Geneva, sans-serif
font.size: 10.5
axes.titlesize: 13
axes.titleweight: bold
axes.labelsize: 10.5
xtick.labelsize: 8.5
ytick.labelsize: 8.5
legend.fontsize: 8.5
figure.titlesize: 16
figure.titleweight: bold
axes.titlelocation: left
axes.titlepad: 12.0
axes.labelpad: 6.0

# Series colours: the four accent bases in brand order, then their
# Dunkel 1 steps, then Hell 2. Past twelve the cycle repeats, which
# is the signal to merge categories, not to invent a colour.
axes.prop_cycle: cycler('color', ['77C5D8', 'ADCA2A', 'EE6A87', 'FCC300', '449DC2', '7D9E38', 'BB365D', 'F7A315', 'BAE0EA', 'D6E28C', 'F6A9B2', 'FFE086'])

# Structure, not decoration. One light grid on the value axis only,
# sitting behind the data, in the structural grey.
axes.grid: True
axes.grid.axis: y
axes.axisbelow: True
grid.color: F0F0F0
grid.linestyle: -
grid.linewidth: 0.8
grid.alpha: 1.0
axes.edgecolor: 000000
axes.linewidth: 0.8
axes.spines.top: False
axes.spines.right: False
axes.spines.left: True
axes.spines.bottom: True
xtick.direction: out
ytick.direction: out
xtick.major.size: 3.0
ytick.major.size: 3.0
xtick.minor.size: 0.0
ytick.minor.size: 0.0

# Marks. The legend carries no box; whitespace separates instead.
lines.linewidth: 2.0
lines.markersize: 6.0
lines.solid_capstyle: round
patch.linewidth: 0.0
patch.force_edgecolor: False
hatch.linewidth: 0.8
legend.frameon: False
legend.borderaxespad: 0.8
legend.handlelength: 1.6

# Output.
figure.figsize: 7.2, 4.05
figure.dpi: 110
savefig.dpi: 200
savefig.bbox: tight
savefig.transparent: False
